{
  "name": "learn-hono",
  "version": "1.0.0",
  "description": "Starter project for the Learn Hono guide: a typed Hono API with validation, JSX views and tests",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "hono",
    "web-standards",
    "cloudflare-workers",
    "bun",
    "deno",
    "typescript",
    "rpc"
  ],
  "author": "Manthan Ankolekar",
  "license": "MIT"
}
